# Nexus local development configuration
NEXUS_ENV=development

# Backend
NEXUS_BACKEND_HOST=127.0.0.1
NEXUS_BACKEND_PORT=8000
NEXUS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEXUS_DATABASE_URL=

# Frontend
VITE_NEXUS_API_BASE_URL=http://127.0.0.1:8000
VITE_NEXUS_FRONTEND_HOST=127.0.0.1
VITE_NEXUS_FRONTEND_PORT=5173